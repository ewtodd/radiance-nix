+/* ------------------------------------------------------------------ the disk tier */
+/* See ckspill.h for the file and the declarations in prefix.h for the states a checkpoint passes
+ * through: in memory; in memory and being written; on disk only; on disk and being read back into
+ * memory; in memory with its disk copy. All of it runs under the scheduler's lock, on the engine
+ * thread, and none of it waits on the I/O thread. */
+
+/* A checkpoint read back is kept out of the spill for this many steps, so it is still in memory
+ * when its request is admitted. */
+static constexpr uint64_t kSpillPinSteps = 32;
+/* Memory slots kept free ahead of the reservations. */
+static constexpr int64_t kSpillFree = 1;
+
+void PrefixCache::set_spill(CkptSpill* spill, HostArena* store) {
+    spill_ = spill;
+    store_ = store;
+    spill_dead_ = false;
+    ios_.clear();
+    writes_out_ = reads_out_ = 0;
+    disk_.clear();
+    if (!spill_ || !spill_->enabled() || !store_ || !store_->enabled() || !has_linear_) {
+        spill_ = nullptr;
+        return;
+    }
+    disk_.assign((size_t)spill_->slots(), DiskSlot{});
+}
+
+PrefixCache::SpillStats PrefixCache::spill_stats() const {
+    SpillStats s;
+    for (const auto& kvp : ck_by_prefix_) {
+        const Ckpt& c = kvp.second;
+        if (c.disk >= 0 && c.slot < 0) ++s.on_disk;
+        else if (c.disk >= 0 && c.io == 0) ++s.in_memory_and_disk;
+    }
+    s.writes_out = writes_out_;
+    s.reads_out = reads_out_;
+    return s;
+}
+
+void PrefixCache::drop_disk_copy(Ckpt& c) {
+    if (c.disk >= 0 && (size_t)c.disk < disk_.size()) disk_[(size_t)c.disk].used = false;
+    c.disk = -1;
+}
+
+void PrefixCache::drop_memory(Ckpt& c) {
+    if (tiers_) tiers_->release_snapshot(c.prefix);
+    if (c.slot >= 0) kv_->free_checkpoint(c.slot);
+    c.slot = -1;
+    c.valid = false;
+}
+
+/* The start of a step: collect what landed, forget disk copies whose KV pages are gone, keep a
+ * memory slot free. */
+void PrefixCache::spill_step() {
+    ++step_;
+    spill_poll();
+    if (spill_dead_) return;
+    spill_sweep();
+    spill_pump();
+}
+
+void PrefixCache::spill_fail(const std::string& why) {
+    if (spill_dead_) return;
+    spill_dead_ = true;
+    RAD_ERR("checkpoint disk tier: %s -- turned off, checkpoints now leave the store as before",
+            why.c_str());
+    std::vector<std::pair<BlockHash, uint64_t>> gone;
+    for (auto& kvp : ck_by_prefix_) {
+        Ckpt& c = kvp.second;
+        if (c.io != 0) continue;                 /* its completion settles it */
+        if (c.slot < 0 && c.disk >= 0) gone.push_back({kvp.first, c.session});
+        else c.disk = -1;
+    }
+    for (const auto& g : gone) {
+        retire_ckpt(ck_by_prefix_.find(g.first));
+        unindex_ckpt(g.second, g.first);
+    }
+    for (auto& d : disk_) d.used = false;
+}
+
+void PrefixCache::spill_poll() {
+    std::vector<CkptSpill::Done> done;
+    spill_->poll(&done);
+    for (const CkptSpill::Done& d : done) {
+        auto r = ios_.find(d.id);
+        if (r == ios_.end()) continue;
+        const IoRec rec = r->second;
+        ios_.erase(r);
+        if (rec.write) --writes_out_; else --reads_out_;
+        if (rec.disk >= 0 && (size_t)rec.disk < disk_.size()) disk_[(size_t)rec.disk].busy = false;
+        const double ms = (double)(rad_mono_ns() - rec.t0) / 1e6;
+        auto it = ck_by_prefix_.find(rec.key);
+        /* The checkpoint may have been retired meanwhile (orphan), or replaced by another under
+         * the same key. */
+        Ckpt* c = (!rec.orphan && it != ck_by_prefix_.end() && it->second.io == d.id) ? &it->second : nullptr;
+        if (rec.orphan || !c) {
+            if (rec.ram >= 0) kv_->free_checkpoint(rec.ram);
+            if (!d.ok) spill_fail(d.err);
+            continue;
+        }
+        c->io = 0;
+        c->io_write = false;
+        if (!d.ok) {
+            if (rec.write) {
+                drop_disk_copy(*c);
+            } else {
+                const uint64_t session = c->session;
+                retire_ckpt(it);                 /* frees the memory slot it was read into */
+                unindex_ckpt(session, rec.key);
+            }
+            spill_fail(d.err);
+            continue;
+        }
+        const int64_t bytes = store_ ? store_->slot_bytes() : 0;
+        if (rec.write) {
+            ++stats_.disk_spills;
+            stats_.disk_bytes_written += bytes;
+            RAD_INFO("checkpoint disk tier: spilled the %lld-token snapshot of session %llu to disk "
+                     "slot %d (%.0f ms, %.1f MiB)", (long long)c->pos, (unsigned long long)c->session,
+                     (int)rec.disk, ms, (double)bytes / 1048576.0);
+            if (spill_dead_) drop_disk_copy(*c);
+            else if (!handed(rec.key) && !reserved(rec.key)) drop_memory(*c);
+        } else {
+            ++stats_.disk_hits;
+            stats_.disk_bytes_read += bytes;
+            c->valid = true;
+            c->used = ++clock_;
+            c->used_ns = rad_mono_ns();
+            c->pin = step_ + kSpillPinSteps;
+            if (tiers_) tiers_->note_snapshot(c->prefix, c->slot, c->pos);
+            RAD_INFO("checkpoint disk tier: read the %lld-token snapshot of session %llu back from "
+                     "disk slot %d (%.0f ms, %.1f MiB)", (long long)c->pos,
+                     (unsigned long long)c->session, (int)rec.disk, ms, (double)bytes / 1048576.0);
+            if (spill_dead_) drop_disk_copy(*c);
+        }
+    }
+}
+
+/* A disk copy is worth keeping only while the chain it belongs to is in the cache: its KV pages
+ * are what a hit adopts. Once the entry has gone, the copy goes like an evicted snapshot. */
+void PrefixCache::spill_sweep() {
+    std::vector<BlockHash> gone;
+    for (auto& kvp : ck_by_prefix_) {
+        Ckpt& c = kvp.second;
+        if (c.disk < 0 || c.io != 0) continue;
+        if (map_.count(kvp.first)) c.seen = true;
+        else if (c.seen) gone.push_back(kvp.first);
+    }
+    for (const BlockHash& h : gone) {
+        auto it = ck_by_prefix_.find(h);
+        if (it == ck_by_prefix_.end()) continue;
+        ++stats_.disk_dropped;
+        if (it->second.slot >= 0) { drop_disk_copy(it->second); continue; }
+        const uint64_t session = it->second.session;
+        retire_ckpt(it);
+        unindex_ckpt(session, h);
+        ++stats_.ckpt_evictions;
+    }
+}
+
+/* A disk slot to write into: a free one, else the least recently used checkpoint's. */
+int PrefixCache::take_disk_slot() {
+    int best = -1;
+    uint64_t best_used = UINT64_MAX;
+    for (size_t i = 0; i < disk_.size(); ++i) {
+        DiskSlot& d = disk_[i];
+        if (d.busy) continue;
+        if (!d.used) return (int)i;
+        auto o = ck_by_prefix_.find(d.owner);
+        if (o == ck_by_prefix_.end()) { d.used = false; return (int)i; }
+        if (o->second.io != 0) continue;
+        if (o->second.used < best_used) { best_used = o->second.used; best = (int)i; }
+    }
+    if (best < 0) return -1;
+    auto o = ck_by_prefix_.find(disk_[(size_t)best].owner);
+    if (o->second.slot >= 0) {
+        drop_disk_copy(o->second);
+    } else {
+        const BlockHash key = o->first;
+        const uint64_t session = o->second.session;
+        retire_ckpt(o);                          /* frees its disk slot */
+        unindex_ckpt(session, key);
+        ++stats_.disk_dropped;
+        ++stats_.ckpt_evictions;
+    }
+    return best;
+}
+
+/* Keep kSpillFree memory slots free, counting those a write in flight will free: the least
+ * recently used checkpoint nothing needs this step goes to disk, or, with its disk copy still
+ * there from an earlier read, simply loses its memory. */
+void PrefixCache::spill_pump() {
+    while (kv_->free_checkpoint_slots() + writes_out_ < kSpillFree) {
+        Ckpt* v = nullptr;
+        for (auto& kvp : ck_by_prefix_) {
+            Ckpt& c = kvp.second;
+            if (c.slot < 0 || !c.valid || c.io != 0 || c.pin > step_ ||
+                handed(kvp.first) || reserved(kvp.first))
+                continue;
+            if (!v || c.used < v->used) v = &c;
+        }
+        if (!v) return;
+        if (v->disk >= 0) {
+            drop_memory(*v);
+            continue;
+        }
+        const int d = take_disk_slot();
+        if (d < 0) return;
+        const uint64_t id = spill_->write(store_->at(v->slot), d, v->prefix.hi, v->prefix.lo, v->pos);
+        v->io = id;
+        v->io_write = true;
+        v->disk = d;
+        disk_[(size_t)d] = DiskSlot{ v->prefix, true, true };
+        ios_[id] = IoRec{ true, v->prefix, v->slot, d, false, rad_mono_ns() };
+        ++writes_out_;
+    }
+}
+
+bool PrefixCache::await_disk(const std::vector<int32_t>& tokens, const std::vector<MMContentKey>& mm) {
+    if (!spill_on() || !enabled_ || tokens.empty()) return false;
+    bool any_disk = false;
+    for (const auto& kvp : ck_by_prefix_) if (kvp.second.disk >= 0 && kvp.second.slot < 0) { any_disk = true; break; }
+    if (!any_disk && writes_out_ == 0 && reads_out_ == 0) return false;
+
+    /* The chain as lookup walks it. */
+    const int64_t n_full = (int64_t)tokens.size() / block_size_;
+    const std::vector<BlockHash> hs = chain_all(tokens, mm, n_full);
+    int64_t matched = 0;
+    for (; matched < n_full; ++matched) {
+        auto it = map_.find(hs[(size_t)matched]);
+        if (it == map_.end() || !it->second.in_lru ||
+            !same_tokens(it->second, tokens.data() + matched * block_size_))
+            break;
+    }
+    if (matched * block_size_ >= (int64_t)tokens.size() && matched > 0) --matched;
+    const int64_t limit = matched * block_size_;
+
+    /* The deepest checkpoint on the chain, wherever it is. */
+    Ckpt* best = nullptr;
+    for (auto& kvp : ck_by_prefix_) {
+        Ckpt& c = kvp.second;
+        const bool there = (c.valid && c.slot >= 0) || (!c.valid && c.disk >= 0);
+        if (!there || c.pos <= 0 || c.pos > limit || c.pos % block_size_ != 0 ||
+            c.pos / block_size_ > (int64_t)hs.size())
+            continue;
+        if (best && c.pos <= best->pos) continue;
+        if (hs[(size_t)(c.pos / block_size_ - 1)] != kvp.first) continue;
+        best = &c;
+    }
+    if (!best) return false;
+
+    if (best->valid) {
+        /* In memory. If a spill is under way for lack of room, the checkpoint this request will
+         * write at the end of its prompt wants that room: wait for it. */
+        if (writes_out_ > 0 && kv_->free_checkpoint_slots() == 0) { ++stats_.disk_waits; return true; }
+        return false;
+    }
+    if (best->io != 0) return true;              /* being read */
+    int32_t slot = -1;
+    if (kv_->alloc_checkpoint(&slot) < 0) { ++stats_.disk_waits; return true; }   /* spill_pump is making room */
+    const uint64_t id = spill_->read(store_->at(slot), best->disk, best->prefix.hi, best->prefix.lo, best->pos);
+    best->slot = slot;
+    best->io = id;
+    best->io_write = false;
+    best->used = ++clock_;
+    disk_[(size_t)best->disk].busy = true;
+    ios_[id] = IoRec{ false, best->prefix, slot, best->disk, false, rad_mono_ns() };
+    ++reads_out_;
+    ++stats_.disk_waits;
+    return true;
+}
+
 }  /* namespace rad */
