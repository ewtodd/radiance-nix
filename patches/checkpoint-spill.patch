+/* ---------------------------------------------------------------- the disk tier (ckspill.h) */
+
+static void pump_steps(Fixture& f, const std::function<bool()>& done) {
+    for (int i = 0; i < 4000 && !done(); ++i) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+        f.pc.begin_step();
+    }
+}
+
+TEST(a_snapshot_leaves_the_store_through_the_disk_and_comes_back_byte_for_byte) {
+    Fixture f;
+    REQUIRE_EQ(f.build(/*with_linear=*/true, /*ckpt_slots=*/2), RAD_OK);
+    std::string dir = radtest::tmp_path("ckspill.XXXXXX");
+    REQUIRE(mkdtemp(dir.data()) != nullptr);
+    CkptSpill spill;
+    std::string err;
+    REQUIRE(spill.open(dir, 8, f.ck.slot_bytes(), 0x1234, &err));
+    f.pc.set_spill(&spill, &f.ck);
+    REQUIRE(f.pc.spill_on());
+    PCBinding<PrefixCache> b(&f.pc);
+
+    /* Two conversations fill the two slots; each snapshot's slot holds a pattern of its own. */
+    const Request a = turn(1, tok_run(100, 300), tok_run(9000, 40));
+    const Request c = turn(2, tok_run(5000, 300), tok_run(9100, 40));
+    const int32_t sa = serve_turn(f, b, a, 320);
+    std::memset(f.ck.at(sa), 0xa5, (size_t)f.ck.slot_bytes());
+    const int32_t sc = serve_turn(f, b, c, 320);
+    std::memset(f.ck.at(sc), 0x3c, (size_t)f.ck.slot_bytes());
+    CHECK_EQ(f.ck.free_slots(), 0);
+
+    /* The next step keeps a slot free: the least recently used goes to the disk first. */
+    pump_steps(f, [&] { return f.ck.free_slots() >= 1; });
+    CHECK_EQ(f.ck.free_slots(), 1);
+    CHECK_EQ(f.pc.spill_stats().on_disk, 1);
+    CHECK(f.pc.stats().disk_spills == 1);
+
+    /* A follow-up to the spilled conversation waits while it is read back, then hits it. */
+    const Request next = turn(3, cat(cat(a.prompt, a.output), tok_run(20000, 50)), {});
+    CHECK(f.pc.await_disk(next.prompt, {}));
+    pump_steps(f, [&] { return !f.pc.await_disk(next.prompt, {}); });
+    const CacheHit h = b.lookup(next, nullptr, nullptr);
+    CHECK_EQ(h.n_linear_tokens, 320);
+    REQUIRE(h.checkpoint_slot >= 0);
+    const unsigned char* p = (const unsigned char*)f.ck.at(h.checkpoint_slot);
+    bool same = true;
+    for (int64_t i = 0; i < f.ck.slot_bytes(); ++i) same = same && p[i] == 0xa5;
+    CHECK(same);
+    CHECK(f.pc.stats().disk_hits == 1);
+    /* The read took the free slot, so the other conversation went to the disk in its turn. */
+    CHECK_EQ((int64_t)spill.totals.bytes_written.load(), 2 * f.ck.slot_bytes());
+    CHECK_EQ((int64_t)spill.totals.bytes_read.load(), f.ck.slot_bytes());
+    f.pc.set_spill(nullptr, nullptr);
+    spill.close();
+    std::filesystem::remove_all(dir);
+}
+
+TEST(a_corrupt_slot_turns_the_disk_tier_off_and_the_request_goes_on_without_it) {
+    Fixture f;
+    REQUIRE_EQ(f.build(/*with_linear=*/true, /*ckpt_slots=*/2), RAD_OK);
+    std::string dir = radtest::tmp_path("ckspill.XXXXXX");
+    REQUIRE(mkdtemp(dir.data()) != nullptr);
+    CkptSpill spill;
+    std::string err;
+    REQUIRE(spill.open(dir, 8, f.ck.slot_bytes(), 0x1234, &err));
+    f.pc.set_spill(&spill, &f.ck);
+    PCBinding<PrefixCache> b(&f.pc);
+    const Request a = turn(1, tok_run(100, 300), tok_run(9000, 40));
+    const Request c = turn(2, tok_run(5000, 300), tok_run(9100, 40));
+    serve_turn(f, b, a, 320);
+    serve_turn(f, b, c, 320);
+    pump_steps(f, [&] { return f.pc.spill_stats().on_disk == 1; });
+    REQUIRE_EQ(f.pc.spill_stats().on_disk, 1);
+    /* Damage the payload on the disk. */
+    int fd = ::open(spill.path().c_str(), O_RDWR);
+    REQUIRE(fd >= 0);
+    const char junk[16] = { 1 };
+    for (int s = 0; s < 8; ++s) CHECK(::pwrite(fd, junk, 16, (off_t)s * spill.stride() + 8192) == 16);
+    ::close(fd);
+    const Request next = turn(3, cat(cat(a.prompt, a.output), tok_run(20000, 50)), {});
+    pump_steps(f, [&] { return !f.pc.await_disk(next.prompt, {}); });
+    CHECK(!f.pc.spill_on());
+    const CacheHit h = b.lookup(next, nullptr, nullptr);
+    CHECK_EQ(h.checkpoint_slot, -1);
+    f.pc.set_spill(nullptr, nullptr);
+    spill.close();
+    std::filesystem::remove_all(dir);
+}
