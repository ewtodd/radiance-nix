diff --git a/core/mem/ckspill.cpp b/core/mem/ckspill.cpp
new file mode 100644
index 0000000..1fe8294
--- /dev/null
+++ b/core/mem/ckspill.cpp
@@ -0,0 +1,237 @@
+/* ckspill.cpp -- see ckspill.h. */
+#include "mem/ckspill.h"
+
+#include "rad_internal.h"
+
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <filesystem>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace rad {
+
+namespace {
+std::atomic<const CkptSpill::Totals*> g_totals{nullptr};
+}  /* namespace */
+
+const CkptSpill::Totals* ckpt_spill_totals() { return g_totals.load(); }
+
+namespace {
+constexpr int64_t  kPage = 4096;
+constexpr size_t   kChunk = (size_t)4 << 20;          /* the bounce buffer, the unit of one pread/pwrite */
+constexpr uint64_t kMagic = 0x31504b43444152ull;      /* "RADCKP1" */
+constexpr uint32_t kVersion = 1;
+
+struct Header {
+    uint64_t magic;
+    uint32_t version, header_bytes;
+    uint64_t fingerprint;
+    uint64_t key_hi, key_lo;
+    int64_t  pos;
+    uint64_t payload_bytes;
+    uint64_t payload_sum;
+    uint64_t header_sum;      /* of every field above */
+};
+static_assert(sizeof(Header) <= kPage, "the header is one page");
+
+int64_t up(int64_t n) { return (n + kPage - 1) / kPage * kPage; }
+}  /* namespace */
+
+/* Four independent lanes of multiply-xorshift over 8-byte words: a few GB/s, which a 150 MiB
+ * checkpoint pays once in each direction. Not cryptographic; it catches a torn or misplaced slot. */
+uint64_t CkptSpill::checksum(const void* p, size_t n, uint64_t seed) {
+    const unsigned char* b = (const unsigned char*)p;
+    uint64_t h[4] = { seed ^ 0x9e3779b97f4a7c15ull, seed + 0xbf58476d1ce4e5b9ull,
+                      seed ^ 0x94d049bb133111ebull, seed + 0x2545f4914f6cdd1dull };
+    size_t i = 0;
+    for (; i + 32 <= n; i += 32) {
+        uint64_t w[4];
+        std::memcpy(w, b + i, 32);
+        for (int k = 0; k < 4; ++k) { h[k] = (h[k] ^ w[k]) * 0x9e3779b97f4a7c15ull; h[k] ^= h[k] >> 29; }
+    }
+    uint64_t t = 0;
+    for (; i < n; ++i) t = (t << 8 | (t >> 56)) ^ b[i];
+    uint64_t r = t ^ (uint64_t)n;
+    for (int k = 0; k < 4; ++k) { r = (r ^ h[k]) * 0xbf58476d1ce4e5b9ull; r ^= r >> 31; }
+    return r;
+}
+
+CkptSpill::~CkptSpill() { close(); }
+
+bool CkptSpill::open(const std::string& dir, int n_slots, int64_t slot_bytes, uint64_t fingerprint,
+                     std::string* err) {
+    close();
+    auto fail = [&](const std::string& m) { if (err) *err = m; close(); return false; };
+    if (dir.empty() || n_slots <= 0 || slot_bytes <= 0) return fail("needs a directory and a slot count");
+    std::error_code ec;
+    std::filesystem::create_directories(dir, ec);
+    path_ = dir + "/radiance-checkpoints.bin";
+    n_ = n_slots;
+    slot_bytes_ = slot_bytes;
+    stride_ = kPage + up(slot_bytes);
+    fingerprint_ = fingerprint;
+    direct_ = true;
+    fd_ = ::open(path_.c_str(), O_RDWR | O_CREAT | O_TRUNC | O_DIRECT, 0600);
+    if (fd_ < 0 && errno == EINVAL) {            /* tmpfs and the like */
+        direct_ = false;
+        fd_ = ::open(path_.c_str(), O_RDWR | O_CREAT | O_TRUNC, 0600);
+    }
+    if (fd_ < 0) return fail("open " + path_ + ": " + std::strerror(errno));
+    const off_t total = (off_t)stride_ * n_;
+    const int e = ::posix_fallocate(fd_, 0, total);
+    if (e == EOPNOTSUPP || e == EINVAL) {
+        if (::ftruncate(fd_, total) != 0) return fail(std::string("ftruncate: ") + std::strerror(errno));
+    } else if (e != 0) {
+        return fail("allocating " + std::to_string(total >> 20) + " MiB in " + path_ + ": " + std::strerror(e));
+    }
+    if (::posix_memalign((void**)&bounce_, kPage, kChunk) != 0) return fail("no memory for the bounce buffer");
+    totals.slots = n_;
+    g_totals = &totals;
+    stop_ = false;
+    th_ = std::thread([this] { loop(); });
+    return true;
+}
+
+void CkptSpill::close() {
+    if (g_totals.load() == &totals) g_totals = nullptr;
+    if (th_.joinable()) {
+        { std::lock_guard<std::mutex> lk(mu_); stop_ = true; }
+        cv_.notify_all();
+        th_.join();
+    }
+    if (fd_ >= 0) { ::close(fd_); fd_ = -1; }
+    if (bounce_) { std::free(bounce_); bounce_ = nullptr; }
+    q_.clear();
+    done_.clear();
+    pending_ = 0;
+}
+
+uint64_t CkptSpill::write(const void* src, int dslot, uint64_t key_hi, uint64_t key_lo, int64_t pos) {
+    Op op;
+    op.write = true; op.mem = (char*)const_cast<void*>(src); op.dslot = dslot;
+    op.key_hi = key_hi; op.key_lo = key_lo; op.pos = pos;
+    { std::lock_guard<std::mutex> lk(mu_); op.id = ++next_id_; q_.push_back(op); }
+    ++pending_;
+    cv_.notify_one();
+    return op.id;
+}
+
+uint64_t CkptSpill::read(void* dst, int dslot, uint64_t key_hi, uint64_t key_lo, int64_t pos) {
+    Op op;
+    op.write = false; op.mem = (char*)dst; op.dslot = dslot;
+    op.key_hi = key_hi; op.key_lo = key_lo; op.pos = pos;
+    { std::lock_guard<std::mutex> lk(mu_); op.id = ++next_id_; q_.push_back(op); }
+    ++pending_;
+    cv_.notify_one();
+    return op.id;
+}
+
+void CkptSpill::poll(std::vector<Done>* out) {
+    std::lock_guard<std::mutex> lk(mu_);
+    for (Done& d : done_) out->push_back(std::move(d));
+    pending_ -= (int)done_.size();
+    done_.clear();
+}
+
+void CkptSpill::loop() {
+    for (;;) {
+        Op op;
+        {
+            std::unique_lock<std::mutex> lk(mu_);
+            cv_.wait(lk, [&] { return stop_ || !q_.empty(); });
+            if (stop_) return;
+            op = q_.front();
+            q_.pop_front();
+        }
+        if (hook) hook(op.write);
+        Done d;
+        d.id = op.id; d.write = op.write;
+        run(op, &d);
+        { std::lock_guard<std::mutex> lk(mu_); done_.push_back(std::move(d)); }
+    }
+}
+
+bool CkptSpill::xfer(bool write, char* buf, size_t n, off_t off, std::string* err) {
+    for (size_t done = 0; done < n;) {
+        const ssize_t r = write ? ::pwrite(fd_, buf + done, n - done, off + (off_t)done)
+                                : ::pread(fd_, buf + done, n - done, off + (off_t)done);
+        if (r < 0 && errno == EINTR) continue;
+        if (r <= 0) {
+            *err = std::string(write ? "write" : "read") + " at " + std::to_string((long long)off) + ": " +
+                   (r < 0 ? std::strerror(errno) : "end of file");
+            return false;
+        }
+        done += (size_t)r;
+    }
+    return true;
+}
+
+void CkptSpill::run(const Op& op, Done* d) {
+    const off_t base = (off_t)op.dslot * (off_t)stride_;
+    const size_t total = (size_t)up(slot_bytes_);
+    std::string err;
+    bool ok = true;
+    uint64_t sum = 0;
+    Header h;
+    if (op.write) {
+        /* Payload first, header last: a slot is valid only once its header says so. */
+        for (size_t at = 0; at < total && ok; at += kChunk) {
+            const size_t n = std::min(kChunk, total - at);
+            const size_t real = at < (size_t)slot_bytes_ ? std::min(n, (size_t)slot_bytes_ - at) : 0;
+            if (real) std::memcpy(bounce_, op.mem + at, real);
+            if (real < n) std::memset(bounce_ + real, 0, n - real);
+            if (real) sum = checksum(bounce_, real, sum);
+            ok = xfer(true, bounce_, n, base + kPage + (off_t)at, &err);
+        }
+        if (ok) {
+            std::memset(bounce_, 0, kPage);
+            h = Header{};
+            h.magic = kMagic; h.version = kVersion; h.header_bytes = (uint32_t)sizeof(Header);
+            h.fingerprint = fingerprint_; h.key_hi = op.key_hi; h.key_lo = op.key_lo; h.pos = op.pos;
+            h.payload_bytes = (uint64_t)slot_bytes_; h.payload_sum = sum;
+            h.header_sum = checksum(&h, offsetof(Header, header_sum));
+            std::memcpy(bounce_, &h, sizeof h);
+            ok = xfer(true, bounce_, kPage, base, &err);
+        }
+        if (ok) {
+            totals.bytes_written += (uint64_t)slot_bytes_;
+            ++totals.spills;
+        }
+        if (!direct_) {
+            ::fdatasync(fd_);
+            ::posix_fadvise(fd_, base, (off_t)stride_, POSIX_FADV_DONTNEED);
+        }
+    } else {
+        ok = xfer(false, bounce_, kPage, base, &err);
+        if (ok) {
+            std::memcpy(&h, bounce_, sizeof h);
+            if (h.magic != kMagic || h.version != kVersion ||
+                h.header_sum != checksum(&h, offsetof(Header, header_sum)))
+                { ok = false; err = "slot " + std::to_string(op.dslot) + " holds no checkpoint header"; }
+            else if (h.fingerprint != fingerprint_ || h.key_hi != op.key_hi || h.key_lo != op.key_lo ||
+                     h.pos != op.pos || h.payload_bytes != (uint64_t)slot_bytes_)
+                { ok = false; err = "slot " + std::to_string(op.dslot) + " holds a different checkpoint than the index names"; }
+        }
+        for (size_t at = 0; at < total && ok; at += kChunk) {
+            const size_t n = std::min(kChunk, total - at);
+            ok = xfer(false, bounce_, n, base + kPage + (off_t)at, &err);
+            if (!ok) break;
+            const size_t real = at < (size_t)slot_bytes_ ? std::min(n, (size_t)slot_bytes_ - at) : 0;
+            if (real) { sum = checksum(bounce_, real, sum); std::memcpy(op.mem + at, bounce_, real); }
+        }
+        if (ok && sum != h.payload_sum)
+            { ok = false; err = "slot " + std::to_string(op.dslot) + " read back differently from what was written"; }
+        if (ok) {
+            totals.bytes_read += (uint64_t)slot_bytes_;
+            ++totals.loads;
+        }
+        if (!direct_) ::posix_fadvise(fd_, base, (off_t)stride_, POSIX_FADV_DONTNEED);
+    }
+    d->ok = ok;
+    d->err = err;
+}
+
+}  /* namespace rad */
diff --git a/core/mem/ckspill.h b/core/mem/ckspill.h
new file mode 100644
index 0000000..f8e2e01
--- /dev/null
+++ b/core/mem/ckspill.h
@@ -0,0 +1,102 @@
+/* ckspill.h -- the disk tier of the checkpoint store (--checkpoint-dir, --disk-checkpoints).
+ *
+ * A checkpoint slot is the linear-attention state at a prefix boundary, a sizeable fraction of a
+ * gigabyte of pinned host memory (--checkpoint-slots). This is a second, larger home for them on a
+ * disk, written back when a slot would be evicted (PrefixCache::spill_pump) and read back into a
+ * free slot when a request hits one (PrefixCache::await_disk). It is never written through: a
+ * checkpoint reaches the disk only as it leaves memory.
+ *
+ * One preallocated file of N slots. A slot is a header block (magic, a fingerprint of everything
+ * that decides what the bytes mean, the prefix key and position, the payload checksum) and the
+ * payload, padded to 4 KiB. O_DIRECT where the filesystem takes it (buffered, with the pages
+ * dropped after each operation, where it does not). One I/O thread works the queue in order and
+ * never takes a lock of the scheduler's; completions are collected by poll() on the engine
+ * thread. The index (which key is in which slot) lives in PrefixCache and in this process only: a
+ * restart does not reload the file, and whatever it holds is ignored. */
+#pragma once
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace rad {
+
+class CkptSpill {
+public:
+    struct Done {
+        uint64_t id = 0;
+        bool     write = false;
+        bool     ok = false;
+        std::string err;
+    };
+    /* Totals since open, readable from any thread (the metrics). */
+    struct Totals {
+        std::atomic<uint64_t> spills{0}, loads{0}, bytes_written{0}, bytes_read{0};
+        std::atomic<int64_t>  slots{0}, in_use{0};
+    };
+
+    ~CkptSpill();
+    /* `slot_bytes` is one checkpoint (the arena's slot). `fingerprint` ties the file's content to
+     * the model, layout, dtype, TP degree and engine version. False with `*err` set when the file
+     * cannot be made. */
+    bool open(const std::string& dir, int n_slots, int64_t slot_bytes, uint64_t fingerprint,
+              std::string* err);
+    void close();
+    bool enabled() const { return fd_ >= 0; }
+    bool direct() const { return direct_; }
+    int  slots() const { return n_; }
+    const std::string& path() const { return path_; }
+
+    /* Queue a write of `src` (slot_bytes) into disk slot `dslot`, or a read of it into `dst`. The
+     * memory must stay put and unwritten until the operation completes. Returns its id. */
+    uint64_t write(const void* src, int dslot, uint64_t key_hi, uint64_t key_lo, int64_t pos);
+    uint64_t read(void* dst, int dslot, uint64_t key_hi, uint64_t key_lo, int64_t pos);
+    /* Finished operations, oldest first. */
+    void poll(std::vector<Done>* out);
+    int  pending() const { return pending_.load(); }
+
+    Totals totals;
+    /* Tests: runs on the I/O thread before each operation. */
+    void (*hook)(bool write) = nullptr;
+
+    static uint64_t checksum(const void* p, size_t n, uint64_t seed = 0);
+    int64_t stride() const { return stride_; }
+
+private:
+    struct Op {
+        uint64_t id = 0;
+        bool     write = false;
+        char*    mem = nullptr;
+        int      dslot = 0;
+        uint64_t key_hi = 0, key_lo = 0;
+        int64_t  pos = 0;
+    };
+    void loop();
+    void run(const Op& op, Done* d);
+    bool xfer(bool write, char* buf, size_t n, off_t off, std::string* err);
+
